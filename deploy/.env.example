# TradeLens environment (Detailed Design 6.1). Copy to deploy/.env and fill in.
# Lines marked SECRET must be replaced; `make doctor` rejects the change-me placeholder.

# --- Common
APP_ENV=development
TZ=UTC
LOG_LEVEL=info
SITE_HOST=tradelens.com
APP_HOST=app.tradelens.com
ADMIN_HOST=admin.tradelens.com
ENABLE_API_DOCS=false

# --- Database (owner runs migrations; the app role has data rights only)
POSTGRES_DB=tradelens
POSTGRES_USER=tradelens_owner
POSTGRES_PASSWORD=change-me
APP_DB_USER=tradelens_app
APP_DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://tradelens_app:change-me@postgres:5432/tradelens
DATABASE_MIGRATION_URL=postgresql+psycopg://tradelens_owner:change-me@postgres:5432/tradelens

# --- Cache
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# --- Security (openssl rand -hex 32)
SESSION_SECRET=change-me
CSRF_SECRET=change-me
TOTP_ENCRYPTION_KEY=change-me
SESSION_IDLE_DAYS=7
ADMIN_SESSION_HOURS=8
MAX_SESSIONS_PER_USER=2
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Rate limits
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_MIN=5
RATE_LIMIT_LOGIN_PER_IP_PER_MIN=20
RATE_LIMIT_API_PER_USER_PER_MIN=120
RATE_LIMIT_CUSTOM_CHART_PER_USER_PER_MIN=20
RATE_LIMIT_ANON_PER_IP_PER_MIN=5

# --- Live updates
SSE_MAX_STREAMS_PER_USER=6
SSE_PRICE_THROTTLE_MS=500
PRICE_STALE_AFTER_SECONDS=10

# --- Admin gate (Cloudflare Access)
CF_ACCESS_ENABLED=true
CF_ACCESS_TEAM_DOMAIN=tradelens.cloudflareaccess.com
CF_ACCESS_AUD=change-me

# --- Market data provider (CR-004): twelvedata in development, oanda later, fake = offline
MARKET_DATA_PROVIDER=twelvedata
# Your own key goes in deploy/.env only (never commit it). FREE plan: 8 credits/min, 800/day.
TWELVEDATA_API_KEY=change-me
TWELVEDATA_LIVE_INSTRUMENTS=EUR_USD,XAU_USD
TWELVEDATA_CREDITS_PER_MINUTE=8
TWELVEDATA_CREDITS_PER_DAY=800

# --- OANDA (used when MARKET_DATA_PROVIDER=oanda; live needs the commercial licence)
OANDA_ENV=practice
OANDA_API_TOKEN=change-me
OANDA_ACCOUNT_ID=change-me
OANDA_REST_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# --- Worker
SCHEDULER_OFFSET_SECONDS=2
CANDLE_RETRY_INTERVAL_SECONDS=2
CANDLE_RETRY_MAX_SECONDS=60
BACKFILL_MIN_CANDLES=2500

# --- Razorpay (key prefix must match the mode: rzp_test_ / rzp_live_)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID_TEST=change-me
RAZORPAY_KEY_SECRET_TEST=change-me
RAZORPAY_WEBHOOK_SECRET_TEST=change-me
RAZORPAY_KEY_ID_LIVE=
RAZORPAY_KEY_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_LIVE=

# --- Billing policy
REFUND_WINDOW_DAYS=7
PAYMENT_GRACE_DAYS=3
FOUNDER_RESERVATION_MINUTES=30

# --- Email
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=change-me
SMTP_PASSWORD=change-me
EMAIL_FROM_ADDRESS=no-reply@tradelens.com
EMAIL_FROM_NAME=TradeLens
EMAIL_REPLY_TO=support@tradelens.com
EMAIL_OUTBOX_MAX_ATTEMPTS=5

# --- Monitoring
ADMIN_ALERT_EMAILS=owner@example.com
ADMIN_ALERT_MIN_INTERVAL_MINUTES=30
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TTL_SECONDS=15
HEALTH_CHECK_INTERVAL_SECONDS=30
SERIES_DELAYED_ALERT_MINUTES=15
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=development

# --- Web
API_INTERNAL_URL=http://api:8000
SITE_URL=https://tradelens.com
APP_URL=https://app.tradelens.com
ADMIN_URL=https://admin.tradelens.com

# --- Proxy (Cloudflare Origin CA certificate, files in deploy/certs/)
TLS_CERT_FILE=/etc/caddy/certs/origin.pem
TLS_KEY_FILE=/etc/caddy/certs/origin.key

# --- Backup (Cloudflare R2; backup service arrives with backup scripts)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_SCHEDULE_CRON=30 1 * * *
BACKUP_RETENTION_DAYS=7
