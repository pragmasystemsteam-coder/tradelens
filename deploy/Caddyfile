# TradeLens proxy routing (Detailed Design 6.7).
# Cloudflare sits in front (SSL Full strict, Origin CA certificate).
{
	admin off
	servers {
		# Cloudflare ranges from https://www.cloudflare.com/ips/ -- re-check at every deploy.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(common) {
	tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Container health check only (not published).
:8080 {
	respond /healthz "ok" 200
}

{$SITE_HOST} {
	import common
	encode zstd gzip
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy web:3000
	}
}

www.{$SITE_HOST} {
	tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
	redir https://{$SITE_HOST}{uri} permanent
}

{$APP_HOST} {
	import common
	@compressible not path /api/v1/stream*
	encode @compressible zstd gzip
	handle /api/admin/* {
		respond 404
	}
	handle /api/v1/stream* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

{$ADMIN_HOST} {
	import common
	encode zstd gzip
	handle /api/admin/* {
		reverse_proxy api:8000
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy admin-web:3000
	}
}
